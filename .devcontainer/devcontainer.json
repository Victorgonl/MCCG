
{
	"name": "MCCG",
	"image": "victorgonl/python3.11-torch-cuda:latest",
	"postCreateCommand": "pip install -r requirements.txt",
	"runArgs": [
		"--gpus=all"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-python.isort",
				"njpwerner.autodocstring",
				"ms-toolsai.jupyter",
				"mechatroner.rainbow-csv"
			]
		}
	}
}
